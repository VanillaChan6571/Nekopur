+    // Nekopur start - update open menus when enchanted books are removed or inserted
+    private boolean nekopurRefreshLibrary() {
+        if (this.nekopurRefreshingLibrary || this.enchantSlots.getItem(0).isEmpty()) {
+            return false;
+        }
+        int power = org.nekopur.gameplay.GameplayConfig.enabled
+            ? this.access.evaluate(org.nekopur.gameplay.EnchantingRules::bookshelfPower, this.nekopurLibraryPower)
+            : this.nekopurLibraryPower;
+        if (power == this.nekopurLibraryPower && this.nekopurRulesRevision == org.nekopur.gameplay.GameplayConfig.revision) {
+            return false;
+        }
+        this.nekopurRefreshingLibrary = true;
+        try {
+            this.slotsChanged(this.enchantSlots);
+        } finally {
+            this.nekopurRefreshingLibrary = false;
+        }
+        return true;
+    }
+
