From: VanillaChanny <39040261+VanillaChan6571@users.noreply.github.com>
Date: Tue, 15 Sep 2026 21:52:11 -0700
Subject: [PATCH] Initialize cushion fluid effect position


diff --git a/net/minecraft/world/entity/decoration/Cushion.java b/net/minecraft/world/entity/decoration/Cushion.java
index 6334fddb057d85e1f36a5a8a4e79f28cf032f1f2..8d70c1a0d5a6022b8f816bdcf33732f2ddff43a1 100644
--- a/net/minecraft/world/entity/decoration/Cushion.java
+++ b/net/minecraft/world/entity/decoration/Cushion.java
@@ -122,6 +122,7 @@ public class Cushion extends BlockAttachedEntity {
             BlockPos blockPos = this.blockPosition();
             FluidState fluidState = level.getBlockState(blockPos).getFluidState();
             if (this.collidedWithFluid(fluidState, blockPos, this.position(), this.position())) {
+                this.insideEffectCollector.advanceStep(0, blockPos); // Nekopur - record the cushion fluid contact position before collecting effects
                 fluidState.entityInside(level, blockPos, this, this.insideEffectCollector);
                 this.insideEffectCollector.applyAndClear(this);
             }
